#!/bin/sh
# Supplies HTTPS Git credentials from container secrets without putting tokens
# in clone URLs or repository configuration.
set -eu

[ "${1:-}" = "get" ] || exit 0

protocol=
host=
while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol=$value ;;
    host) host=$value ;;
  esac
done

[ "$protocol" = "https" ] || exit 0

case "$host" in
  github.com)
    [ -n "${GITHUB_TOKEN:-}" ] || exit 0
    printf 'username=%s\npassword=%s\n' "${GITHUB_USERNAME:-x-access-token}" "$GITHUB_TOKEN"
    ;;
  gitlab.com)
    [ -n "${GITLAB_TOKEN:-}" ] || exit 0
    printf 'username=%s\npassword=%s\n' "${GITLAB_USERNAME:-oauth2}" "$GITLAB_TOKEN"
    ;;
esac
