# Image tag to run (see the GitHub package for available tags).
DSH_TAG=latest

# Host interface and port compose publishes the UI on. Anyone who reaches this
# port and holds the launch URL can run commands in the container.
DSH_BIND=127.0.0.1
DSH_PORT=3080

# Authorities the UI is reached by besides localhost, comma separated
# (host, host:port, or URL, e.g. dsh.example.com,192.168.1.10:3080). Requests
# with any other Host header are refused by the /api fence.
DSH_TRUSTED_HOSTS=

# Host directory mounted at /workspace. Empty keeps a named volume.
DSH_WORKSPACE=

# Sandbox fallback for sessions when neither bwrap nor Landlock can enforce
# inside the container (see README).
#DSH_PERMISSION_MODE=danger-full-access
